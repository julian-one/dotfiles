#!/usr/bin/env bash
set -uo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
BREWFILE=$REPO/Brewfile
FORCE=false
STATUS=0

LINKS=(
	"zsh/.zshrc        .zshrc"
	"git/config        .config/git/config"
	"git/ignore        .config/git/ignore"
	"tmux              .config/tmux"
	"nvim              .config/nvim"
	"ssh/config        .ssh/config"
	"claude/CLAUDE.md  .claude/CLAUDE.md"
)

usage() {
	cat <<-EOF
	usage: install [--force|--check]

	  (no flags)  install everything in the Brewfile, then link any config
	              that is not linked yet
	  --force     same, but replace files that are sitting where a symlink
	              should go
	  --check     change nothing, just report what has drifted
	              (exits non-zero if anything has)
	EOF
	exit "${1:-0}"
}

heading() {
	printf '\n==> %s\n' "$1"
}

pass() {
	printf '    %-9s %s\n' "$1" "$2"
}

warn() {
	printf '    %-9s %s\n' "$1" "$2"
	STATUS=1
}

already_linked() {
	local src=$1 dst=$2
	[[ $(readlink "$HOME/$dst" 2>/dev/null) == "$REPO/$src" ]]
}

install_packages() {
	heading 'Homebrew packages'

	if brew bundle --file "$BREWFILE"; then
		pass ok 'everything in the Brewfile is installed'
	else
		warn failed 'brew bundle did not finish cleanly'
	fi
}

install_links() {
	heading 'Symlinks'

	local entry src dst target
	for entry in "${LINKS[@]}"; do
		read -r src dst <<<"$entry"
		target=$HOME/$dst
		mkdir -p "$(dirname "$target")"

		if already_linked "$src" "$dst"; then
			pass ok "~/$dst"
		elif [[ ! -e $target && ! -L $target ]]; then
			ln -s "$REPO/$src" "$target"
			pass linked "~/$dst"
		elif [[ $FORCE == true ]]; then
			rm -rf "$target"
			ln -s "$REPO/$src" "$target"
			pass replaced "~/$dst"
		else
			warn blocked "~/$dst already exists; rerun with --force to replace it"
		fi
	done
}

install_ssh_permissions() {
	heading 'SSH directory'

	mkdir -p "$HOME/.ssh"
	chmod 700 "$HOME/.ssh"
	pass ok '~/.ssh is 700'
}

check_packages() {
	heading 'Homebrew packages'

	if brew bundle check --file "$BREWFILE" >/dev/null 2>&1; then
		pass ok 'everything in the Brewfile is installed'
	else
		warn missing 'something in the Brewfile is not installed; rerun ./install'
	fi
}

check_unowned_packages() {
	heading 'Packages the Brewfile does not own'

	local declared installed pkg unowned=false
	declared=$(brew bundle list --brews --casks --file "$BREWFILE" 2>/dev/null)
	installed=$({ brew leaves; brew list --cask; } 2>/dev/null)

	while read -r pkg; do
		[[ -n $pkg ]] || continue
		if ! grep -qxF "$pkg" <<<"$declared"; then
			warn unowned "$pkg is installed but not in the Brewfile"
			unowned=true
		fi
	done <<<"$installed"

	if [[ $unowned == false ]]; then
		pass ok 'nothing is installed outside the Brewfile'
	fi
}

check_links() {
	heading 'Symlinks'

	local entry src dst target
	for entry in "${LINKS[@]}"; do
		read -r src dst <<<"$entry"
		target=$HOME/$dst

		if already_linked "$src" "$dst"; then
			pass ok "~/$dst"
		elif [[ -L $target ]]; then
			warn drift "~/$dst points at $(readlink "$target")"
		elif [[ -e $target ]]; then
			warn drift "~/$dst is a real file, not a symlink"
		else
			warn missing "~/$dst is not linked yet"
		fi
	done
}

check_ssh_permissions() {
	heading 'SSH directory'

	if [[ $(stat -f %Lp "$HOME/.ssh" 2>/dev/null) == 700 ]]; then
		pass ok '~/.ssh is 700'
	else
		warn drift '~/.ssh is not 700'
	fi
}

run_install() {
	install_packages
	install_links
	install_ssh_permissions
}

run_check() {
	check_packages
	check_unowned_packages
	check_links
	check_ssh_permissions
}

if ! command -v brew >/dev/null; then
	echo 'install: Homebrew is required first, see https://brew.sh' >&2
	exit 1
fi

if [[ $# -gt 1 ]]; then
	echo "install: expected at most one option, got $#" >&2
	usage 2
fi

case ${1:-} in
"") run_install ;;
--force)
	FORCE=true
	run_install
	;;
--check) run_check ;;
-h | --help) usage 0 ;;
*)
	echo "install: unknown option: $1" >&2
	usage 2
	;;
esac

if [[ $STATUS -eq 0 ]]; then
	printf '\nAll good.\n'
else
	printf '\nSome things need attention, see above.\n'
fi

exit "$STATUS"
